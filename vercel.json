{
  "version": 2,
  "builds": [
    {
      "src": "oppadrama_api/app.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "includeFiles": "static/**"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "oppadrama_api/app.py"
    }
  ]
}
